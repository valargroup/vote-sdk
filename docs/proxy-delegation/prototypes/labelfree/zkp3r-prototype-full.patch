+#[test]
+fn zkp3r_rejects_direct_vote_commitment() {
+    // A direct VC = Poseidon(DOMAIN_VC, round, sh, p, o) with p >= 1 cannot
+    // pass R2 (constant 0), whatever d the prover witnesses.
+    let fx = Fx::default();
+    let b0 = build::<ROUTE_TREE_DEPTH>(&fx);
+    let (c1x, c1y) = { let c = b0.c1.map(|p| *p.coordinates().unwrap().x()); (c, b0.c1.map(|p| *p.coordinates().unwrap().y())) };
+    let (c2x, c2y) = { let c = b0.c2.map(|p| *p.coordinates().unwrap().x()); (c, b0.c2.map(|p| *p.coordinates().unwrap().y())) };
+    let sh = shares_hash(b0.blinds, c1x, c2x, c1y, c2y);
+    let vc = vote_commitment_hash(fx.round, sh, pallas::Base::from(fx.p), pallas::Base::from(fx.o));
+    for d in [fx.o, fx.p, fx.d] {
+        let fx2 = Fx { d, ..fx.clone() };
+        let b = build_from_parts::<ROUTE_TREE_DEPTH>(&fx2, vc, b0.share_comms, b0.blinds, b0.c1, b0.c2, b0.randomness, b0.ea_sk);
+        assert!(!ok(&b), "d={d}");
+    }
+}
