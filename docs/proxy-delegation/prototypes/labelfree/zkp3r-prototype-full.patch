+// ----------------------------------------------------------------
+// Tree helpers (empty leaf = Poseidon(0, 0), as vote_commitment_tree).
+// ----------------------------------------------------------------
+
+/// Empty subtree roots `e[0..=depth]`, `e[0]` the empty leaf.
+fn empty_roots(depth: usize) -> Vec<pallas::Base> {
+    let mut e = vec![poseidon_hash_2(pallas::Base::zero(), pallas::Base::zero())];
+    for i in 0..depth {
+        e.push(poseidon_hash_2(e[i], e[i]));
+    }
+    e
+}
+
+/// Root and authentication path for `pos` in a depth-`D` tree whose first
+/// `leaves.len()` positions are filled and the rest empty.
+pub(crate) fn root_and_path<const D: usize>(
+    leaves: &[pallas::Base],
+    pos: usize,
+) -> (pallas::Base, [pallas::Base; D]) {
+    let e = empty_roots(D);
+    let mut level: Vec<pallas::Base> = leaves.to_vec();
+    let mut path = [pallas::Base::zero(); D];
+    let mut p = pos;
+    for lvl in 0..D {
+        path[lvl] = level.get(p ^ 1).copied().unwrap_or(e[lvl]);
+        let mut next = Vec::with_capacity(level.len().div_ceil(2));
+        for pair in level.chunks(2) {
+            let l = pair[0];
+            let r = pair.get(1).copied().unwrap_or(e[lvl]);
+            next.push(poseidon_hash_2(l, r));
+        }
+        level = next;
+        p >>= 1;
+    }
+    (level.first().copied().unwrap_or(e[D]), path)
+}
+
+/// Root of a single leaf at `pos` with all other positions empty.
+fn single_leaf<const D: usize>(leaf: pallas::Base, pos: u32) -> (pallas::Base, [pallas::Base; D]) {
+    let e = empty_roots(D);
+    let path: [pallas::Base; D] = core::array::from_fn(|i| e[i]);
+    let mut cur = leaf;
+    for (i, s) in path.iter().enumerate() {
+        cur = if (pos >> i) & 1 == 0 {
+            poseidon_hash_2(cur, *s)
+        } else {
+            poseidon_hash_2(*s, cur)
+        };
+    }
+    (cur, path)
+}
+
+fn affine(x: pallas::Base, y: pallas::Base) -> pallas::Affine {
+    pallas::Affine::from_xy(x, y).expect("on curve")
+}
+
+// ----------------------------------------------------------------
+// Fixture
+// ----------------------------------------------------------------
+
+/// Inputs for one routed reveal.
+#[derive(Clone)]
+pub(crate) struct Fx {
+    pub shares: [u64; 16],
+    pub d: u64,
+    pub p: u64,
+    pub o: u64,
+    pub share_index: usize,
+    pub round: pallas::Base,
+    pub dc_position: u32,
+    /// Route leaves `(d, p, o)` in append order.
+    pub routes: Vec<(u64, u64, u64)>,
+    /// Which route leaf the prover opens.
+    pub route_open: usize,
+    pub r: pallas::Base,
+}
+
+impl Default for Fx {
+    fn default() -> Self {
+        let mut shares = [0u64; 16];
+        for (i, s) in shares.iter_mut().enumerate() {
+            *s = 625 + 3 * i as u64;
+        }
+        Fx {
+            shares,
+            d: 17,
+            p: 3,
+            o: 1,
+            share_index: 5,
+            round: pallas::Base::from(999u64),
+            dc_position: 0b1011_0110_0101_1100_1010_0011,
+            routes: vec![(4, 3, 0), (17, 1, 2), (9, 3, 1), (17, 3, 1), (17, 4, 0), (23, 3, 2)],
+            route_open: 3,
+            r: pallas::Base::from(0x5eed_1234_u64),
+        }
+    }
+}
+
+/// Built circuit, instance and the intermediate values negatives tweak.
+pub(crate) struct Built<const RD: usize> {
+    pub circuit: Circuit<RD>,
+    pub instance: Instance,
+    pub ea_sk: pallas::Scalar,
+    pub c1: [pallas::Affine; 16],
+    pub c2: [pallas::Affine; 16],
+    pub blinds: [pallas::Base; 16],
+    pub share_comms: [pallas::Base; 16],
+    pub randomness: [pallas::Base; 16],
+    pub dc: pallas::Base,
+}
+
+pub(crate) fn ea_keypair() -> (pallas::Scalar, pallas::Affine) {
+    let sk = pallas::Scalar::from(42u64);
+    (sk, (spend_auth_g_affine() * sk).to_affine())
+}
+
+/// Builds a valid ZKP3R witness and instance for `fx`.
+pub(crate) fn build<const RD: usize>(fx: &Fx) -> Built<RD> {
+    let (ea_sk, ea_pk) = ea_keypair();
+    let randomness: [pallas::Base; 16] = core::array::from_fn(|i| pallas::Base::from((i as u64 + 1) * 101));
+    let blinds: [pallas::Base; 16] = core::array::from_fn(|i| pallas::Base::from(1001u64 + i as u64));
+    let mut c1 = [pallas::Affine::default(); 16];
+    let mut c2 = [pallas::Affine::default(); 16];
+    let (mut c1x, mut c2x, mut c1y, mut c2y) = ([pallas::Base::zero(); 16], [pallas::Base::zero(); 16], [pallas::Base::zero(); 16], [pallas::Base::zero(); 16]);
+    for i in 0..16 {
+        let (a, b, c, d) = elgamal_encrypt(pallas::Base::from(fx.shares[i]), randomness[i], ea_pk).unwrap();
+        (c1x[i], c2x[i], c1y[i], c2y[i]) = (a, b, c, d);
+        c1[i] = affine(a, c);
+        c2[i] = affine(b, d);
+    }
+    let share_comms: [pallas::Base; 16] =
+        core::array::from_fn(|i| share_commitment(blinds[i], c1x[i], c2x[i], c1y[i], c2y[i]));
+    let sh = shares_hash(blinds, c1x, c2x, c1y, c2y);
+    let dc = vote_commitment_hash(fx.round, sh, pallas::Base::zero(), pallas::Base::from(fx.d));
+    build_from_parts::<RD>(fx, dc, share_comms, blinds, c1, c2, randomness, ea_sk)
+}
+
+/// Builds the circuit/instance from an existing DC opening (used by the
+/// ZKP4 end-to-end test as well).
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn build_from_parts<const RD: usize>(
+    fx: &Fx,
+    dc: pallas::Base,
+    share_comms: [pallas::Base; 16],
+    blinds: [pallas::Base; 16],
+    c1: [pallas::Affine; 16],
+    c2: [pallas::Affine; 16],
+    randomness: [pallas::Base; 16],
+    ea_sk: pallas::Scalar,
+) -> Built<RD> {
+    let ea_pk = (spend_auth_g_affine() * ea_sk).to_affine();
+    let (vc_root, vc_path) = single_leaf::<VOTE_COMM_TREE_DEPTH>(dc, fx.dc_position);
+    let leaves: Vec<pallas::Base> = fx
+        .routes
+        .iter()
+        .map(|&(d, p, o)| route_leaf_hash(fx.round, pallas::Base::from(d), pallas::Base::from(p), pallas::Base::from(o)))
+        .collect();
+    let (route_root, route_path) = root_and_path::<RD>(&leaves, fx.route_open);
+    let i = fx.share_index;
+    let (c1p, c2p) = rerandomize(c1[i], c2[i], fx.r, ea_pk);
+    let idx = pallas::Base::from(i as u64);
+    let p = pallas::Base::from(fx.p);
+    let circuit = Circuit::<RD> {
+        vote_comm_tree_path: Value::known(vc_path),
+        vote_comm_tree_position: Value::known(fx.dc_position),
+        share_comms: share_comms.map(Value::known),
+        primary_blind: Value::known(blinds[i]),
+        share_index: Value::known(idx),
+        delegation_commitment: Value::known(dc),
+        delegate_index: Value::known(pallas::Base::from(fx.d)),
+        enc_c1: Value::known(c1[i]),
+        enc_c2: Value::known(c2[i]),
+        rerandomizer: Value::known(fx.r),
+        ea_pk: Value::known(ea_pk),
+        route_tree_path: Value::known(route_path),
+        route_tree_position: Value::known(fx.route_open as u32),
+        vote_decision: Value::unknown(),
+        bucket_rerandomizers: [],
+        onehot_override: None,
+    };
+    let instance = Instance {
+        nullifier: routed_share_nullifier_hash(dc, idx, blinds[i], p),
+        c1: c1p,
+        c2: c2p,
+        proposal_id: p,
+        vote_decision: pallas::Base::from(fx.o),
+        vote_comm_tree_root: vc_root,
+        voting_round_id: fx.round,
+        ea_pk,
+        route_tree_root: route_root,
+    };
+    Built { circuit, instance, ea_sk, c1, c2, blinds, share_comms, randomness, dc }
+}
+
+/// Runs MockProver; returns Ok or the failure summary.
+pub(crate) fn mock<const RD: usize, const M: usize>(c: &Circuit<RD, M>, inst: &[pallas::Base]) -> Result<(), std::string::String> {
+    match MockProver::run(K, c, vec![inst.to_vec()]) {
+        Ok(p) => p.verify().map_err(|e| {
+            // Summarize every failure: instance rows, regions or gates.
+            let locs: Vec<std::string::String> = e
+                .iter()
+                .map(|f| {
+                    let d = format!("{f:?}");
+                    if let Some(r) = d.split("OutsideRegion { row: ").nth(1) {
+                        format!("instance/outside row {}", r.split(' ').next().unwrap_or("?"))
+                    } else if let Some(n) = d.split("name: \"").nth(1) {
+                        let region = n.split('"').next().unwrap_or("?");
+                        let gate = d.split("Gate { index: ").nth(1).and_then(|g| g.split("name: \"").nth(1)).map(|g| g.split('"').next().unwrap_or("?"));
+                        format!("{}{}", region, gate.map(|g| format!(" [gate {g}]")).unwrap_or_default())
+                    } else {
+                        d.chars().take(80).collect()
+                    }
+                })
+                .collect();
+            format!("{} failure(s): {}", e.len(), locs.join("; "))
+        }),
+        Err(e) => Err(format!("synthesis error: {e:?}")),
+    }
+}
+
+fn ok(b: &Built<ROUTE_TREE_DEPTH>) -> bool {
+    ok_raw(b, b.instance.to_halo2_instance())
+}
+
+/// Runs MockProver and prints why a rejected case failed (`--nocapture`).
+fn ok_raw(b: &Built<ROUTE_TREE_DEPTH>, inst: Vec<pallas::Base>) -> bool {
+    match mock(&b.circuit, &inst) {
+        Ok(()) => true,
+        Err(e) => {
+            println!("    rejected: {}", &e[..e.len().min(400)]);
+            false
+        }
+    }
+}
+
+fn base() -> Built<ROUTE_TREE_DEPTH> {
+    build::<ROUTE_TREE_DEPTH>(&Fx::default())
+}
+
+/// Decrypts to `v·G` (no discrete log needed for comparisons).
+fn decrypt(sk: pallas::Scalar, c1: pallas::Affine, c2: pallas::Affine) -> pallas::Point {
+    pallas::Point::from(c2) - c1 * sk
+}
