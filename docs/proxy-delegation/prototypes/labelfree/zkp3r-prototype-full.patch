+#[test]
+fn zkp3r_rejects_wrong_option() {
+    let b = base();
+    let mut inst = b.instance.clone();
+    inst.vote_decision = pallas::Base::from(2u64); // delegate 17 routed p=3 to o=1
+    assert!(!ok_raw(&b, inst.to_halo2_instance()));
