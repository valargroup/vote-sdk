+/// ZKP3R end-to-end: a DC from a passing ZKP4 witness is revealed into the
+/// routed bucket (p, o) for each share, for layout 0 (16 shares) and for the
+/// last-moment layout 1 (`[w, 0 x 15]`, only share 0 revealed). A reveal
+/// claiming another delegate's route fails.
+#[test]
+fn zkp4_dc_revealed_by_zkp3r() {
+    use crate::routed_share_reveal::tests as r;
+    use crate::routed_share_reveal::ROUTE_TREE_DEPTH;
+    let layout1 = {
+        let mut s = [0u64; 16];
+        s[0] = 4_000;
+        s
+    };
+    for shares in [Fx::default().shares, layout1] {
+        let fx = Fx { shares, ..Fx::default() };
+        assert!(verify(&fx), "ZKP4 witness must pass");
+        let b = build(&fx);
+        assert_eq!(b.dc, delegation_commitment_hash(b.round, shares_hash(b.blinds, b.c1.map(|c| c.0), b.c2.map(|c| c.0), b.c1.map(|c| c.1), b.c2.map(|c| c.1)), fx.delegate_index as u32));
+        let to_affine = |(x, y): (pallas::Base, pallas::Base)| pallas::Affine::from_xy(x, y).unwrap();
+        let c1 = b.c1.map(to_affine);
+        let c2 = b.c2.map(to_affine);
+        let d = fx.delegate_index;
+        let routes = vec![(7, 2, 1), (d, 2, 0), (d, 5, 3), (99, 5, 3)];
+        let reveal_idx: Vec<usize> = if shares == layout1 { vec![0] } else { (0..16).collect() };
+        for idx in reveal_idx {
+            for (open, p, o) in [(1usize, 2u64, 0u64), (2, 5, 3)] {
+                let rfx = r::Fx { shares, d, p, o, share_index: idx, round: b.round, dc_position: 0, routes: routes.clone(), route_open: open, r: pallas::Base::from(77u64 + idx as u64) };
+                let built = r::build_from_parts::<ROUTE_TREE_DEPTH>(&rfx, b.dc, b.share_comms, b.blinds, c1, c2, [pallas::Base::one(); 16], pallas::Scalar::from(42u64));
+                r::mock(&built.circuit, &built.instance.to_halo2_instance()).unwrap();
+                // Decrypts to the ZKP4 share value.
+                let sk = pallas::Scalar::from(42u64);
+                let m = pallas::Point::from(built.instance.c2) - built.instance.c1 * sk;
+                assert_eq!(m, spend_auth_g_affine() * pallas::Scalar::from(shares[idx]));
+            }
+            // Delegate 99's route (99, 5, 3) cannot carry delegate d's share.
+            let rfx = r::Fx { shares, d: 99, p: 5, o: 3, share_index: idx, round: b.round, dc_position: 0, routes: routes.clone(), route_open: 3, r: pallas::Base::from(5u64) };
+            let built = r::build_from_parts::<ROUTE_TREE_DEPTH>(&rfx, b.dc, b.share_comms, b.blinds, c1, c2, [pallas::Base::one(); 16], pallas::Scalar::from(42u64));
+            assert!(r::mock(&built.circuit, &built.instance.to_halo2_instance()).is_err());
+        }
+        println!("zkp4 -> zkp3r ok for shares {:?}", shares);
+    }
+}
