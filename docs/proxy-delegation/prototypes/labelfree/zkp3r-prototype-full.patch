+#[test]
+fn zkp3r_rejects_delegate_not_in_route_tree() {
+    // Delegate 17 never routed p = 3; prover opens an empty position.
+    let routes = vec![(4, 3, 0), (17, 1, 2), (9, 3, 1), (23, 3, 2)];
+    let fx = Fx { routes: routes.clone(), route_open: 4, ..Fx::default() };
+    assert!(!ok(&build(&fx)));
+    // Same, opening every existing leaf in turn.
+    for open in 0..routes.len() {
+        let fx = Fx { routes: routes.clone(), route_open: open, ..Fx::default() };
+        assert!(!ok(&build(&fx)), "open={open}");
+    }
+    // Route posted for another round only.
+    let fx = Fx::default();
+    let mut b = build::<ROUTE_TREE_DEPTH>(&fx);
+    let other_round_leaves: Vec<pallas::Base> = fx
+        .routes
+        .iter()
+        .map(|&(d, p, o)| route_leaf_hash(pallas::Base::from(1000u64), pallas::Base::from(d), pallas::Base::from(p), pallas::Base::from(o)))
+        .collect();
+    let (root, path) = root_and_path::<ROUTE_TREE_DEPTH>(&other_round_leaves, fx.route_open);
+    b.circuit.route_tree_path = Value::known(path);
