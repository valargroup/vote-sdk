--- pristine/voting-circuits/src/routed_share_reveal/circuit.rs	1969-12-31 17:00:00
+++ circuit/voting-circuits/src/routed_share_reveal/circuit.rs	2026-10-05 19:00:14
@@ -0,0 +1,835 @@
+//! PROTOTYPE ZKP3R circuit (routed share reveal). See `mod.rs`.
+//!
+//! Conditions:
+//! - R1 DC membership: Poseidon Merkle path (depth 24) from the private DC
+//!   leaf to `vote_comm_tree_root` (instance).
+//! - R2 DC integrity: `DC = Poseidon(DOMAIN_VC, round, shares_hash, 0, d)`,
+//!   with `0` a constant cell and `d` private. A direct-vote VC (`p >= 1`,
+//!   enforced by ZKP2) can therefore never be revealed here.
+//! - R3 shares hash: `shares_hash = Poseidon(share_comm_0..15)`.
+//! - R4 share binding: `share_comms[share_index] = Poseidon(blind, C1.x,
+//!   C2.x, C1.y, C2.y)`, where `C1`, `C2` are private on-curve, non-identity
+//!   points (the original ZKP4 ciphertext, never published).
+//! - R5 re-randomization: `r' != 0`, `C1' = C1 + [r']G`,
+//!   `C2' = C2 + [r']ea_pk` (complete additions). Both coordinates of
+//!   `C1'`, `C2'` and of `ea_pk` are instance cells.
+//! - R6 route membership: `Poseidon(DOMAIN_ROUTE, round, d, p, o)` is a leaf
+//!   of the route tree under `route_tree_root` (instance), using the same
+//!   `d` cell as R2 and the public `p`, `o`.
+//! - R7 nullifier: `Poseidon(TAG, DC, share_index, blind, p)` (instance);
+//!   one per (DC, share, proposal), independent of `o` and of `r'`.
+
+use std::vec::Vec;
+
+use itertools::Itertools;
+use voting_crypto_deps::halo2_gadgets::{
+    ecc::{
+        chip::{EccChip, EccConfig},
+        CircuitVersion, FixedPointBaseField, NonIdentityPoint, ScalarVar,
+    },
+    poseidon::{
+        primitives::{self as poseidon, ConstantLength},
+        Pow5Chip as PoseidonChip, Pow5Config as PoseidonConfig,
+    },
+    utilities::{
+        bool_check,
+        lookup_range_check::{LookupRangeCheck, LookupRangeCheckConfig},
+    },
+};
+use voting_crypto_deps::halo2_proofs::{
+    circuit::{floor_planner, AssignedCell, Layouter, Value},
+    plonk::{
+        self, Advice, Column, ConstraintSystem, Constraints, Expression, Fixed,
+        Instance as InstanceColumn, Selector, TableColumn,
+    },
+    poly::Rotation,
+};
+use voting_crypto_deps::orchard::{
+    circuit::gadget::assign_free_advice,
+    constants::{OrchardBaseFieldBases, OrchardFixedBases},
+};
+use voting_crypto_deps::pasta_curves::{pallas, vesta};
+
+use crate::{
+    gadgets::{
+        elgamal::{base_to_scalar, spend_auth_g_affine},
+        nonzero::NonZeroConfig,
+        poseidon_merkle::{synthesize_poseidon_merkle_path_with_config_schedule, MerkleSwapGate},
+        vote_commitment,
+    },
+    params::{RANGE_CHECK_WORD_BITS, VOTE_COMM_TREE_DEPTH},
+    protocol_hash::poseidon_hash_in_circuit,
+    shares_hash::{compute_shares_hash_from_comms_in_circuit, hash_share_commitment_in_circuit},
+};
+
+/// Circuit size (2^K rows). The 10-bit range-check table alone needs
+/// 1,024 usable rows, so K = 11 is the floor once ECC is present.
+pub const K: u32 = 11;
+
+/// Depth of the per-round route tree: `max_delegates (20,000) x
+/// MAX_PROPOSALS (50) = 1,000,000 <= 2^20` route leaves.
+pub const ROUTE_TREE_DEPTH: usize = 20;
+
+/// Numeric domain tag for route leaves. Distinct from `DOMAIN_VAN = 0` and
+/// `DOMAIN_VC = 1`, so route leaves could share the commitment tree.
+pub const DOMAIN_ROUTE: u64 = 2;
+
+/// Number of Poseidon configurations (primary, Merkle B, route C).
+const POSEIDON_CONFIGS: usize = 3;
+
+pub(crate) const NULLIFIER_OFFSET: usize = 0;
+pub(crate) const C1_X_OFFSET: usize = 1;
+pub(crate) const C1_Y_OFFSET: usize = 2;
+pub(crate) const C2_X_OFFSET: usize = 3;
+pub(crate) const C2_Y_OFFSET: usize = 4;
+pub(crate) const PROPOSAL_ID_OFFSET: usize = 5;
+pub(crate) const VOTE_DECISION_OFFSET: usize = 6;
+pub(crate) const VOTE_COMM_TREE_ROOT_OFFSET: usize = 7;
+pub(crate) const VOTING_ROUND_ID_OFFSET: usize = 8;
+pub(crate) const EA_PK_X_OFFSET: usize = 9;
+pub(crate) const EA_PK_Y_OFFSET: usize = 10;
+pub(crate) const ROUTE_TREE_ROOT_OFFSET: usize = 11;
+
+/// Private-vote (V2) shape: number of decision buckets in the output vector.
+pub const V2_BUCKETS: usize = 8;
+
+/// Instance offsets for the bucketed (`M > 0`) shape: nullifier, then
+/// `c1_x, c2_x, c1_y, c2_y` per bucket (V2 ZKP3 order), then `p`, VC root,
+/// round, `ea_pk`, route root. `o` is private.
+pub(crate) const fn v2_offsets(m: usize) -> (usize, usize, usize, usize, usize, usize) {
+    let p = 1 + 4 * m;
+    (p, p + 1, p + 2, p + 3, p + 4, p + 5)
+}
+
+// ================================================================
+// Native helpers
+// ================================================================
+
+/// Domain tag for routed-share nullifiers: `"routed share spend"` as a
+/// zero-padded little-endian field element (same encoding rule as
+/// `domain_tags::share_spend`).
+pub fn domain_tag_routed_share_spend() -> pallas::Base {
+    use crate::ff::PrimeField;
+    let tag = b"routed share spend";
+    let mut bytes = [0u8; 32];
+    bytes[..tag.len()].copy_from_slice(tag);
+    pallas::Base::from_repr(bytes).expect("short ASCII tag is canonical")
+}
+
+/// Native route leaf: `Poseidon(DOMAIN_ROUTE, round, d, p, o)`.
+pub fn route_leaf_hash(
+    voting_round_id: pallas::Base,
+    delegate_index: pallas::Base,
+    proposal_id: pallas::Base,
+    vote_decision: pallas::Base,
+) -> pallas::Base {
+    poseidon::Hash::<_, poseidon::P128Pow5T3, ConstantLength<5>, 3, 2>::init().hash([
+        pallas::Base::from(DOMAIN_ROUTE),
+        voting_round_id,
+        delegate_index,
+        proposal_id,
+        vote_decision,
+    ])
+}
+
+/// Native routed-share nullifier: `Poseidon(TAG, DC, share_index, blind, p)`.
+pub fn routed_share_nullifier_hash(
+    delegation_commitment: pallas::Base,
+    share_index: pallas::Base,
+    blind: pallas::Base,
+    proposal_id: pallas::Base,
+) -> pallas::Base {
+    poseidon::Hash::<_, poseidon::P128Pow5T3, ConstantLength<5>, 3, 2>::init().hash([
+        domain_tag_routed_share_spend(),
+        delegation_commitment,
+        share_index,
+        blind,
+        proposal_id,
+    ])
+}
+
+/// Native re-randomization: `(C1 + [r]G, C2 + [r]ea_pk)` with `r` read as an
+/// integer (as the in-circuit base-field scalar multiplications do).
+pub fn rerandomize(
+    c1: pallas::Affine,
+    c2: pallas::Affine,
+    r: pallas::Base,
+    ea_pk: pallas::Affine,
+) -> (pallas::Affine, pallas::Affine) {
+    use crate::group::Curve;
+    let r = base_to_scalar(r).expect("base fits in scalar field");
+    let c1p = (c1 + spend_auth_g_affine() * r).to_affine();
+    let c2p = (c2 + ea_pk * r).to_affine();
+    (c1p, c2p)
+}
+
+// ================================================================
+// Config
+// ================================================================
+
+/// Configuration for the routed share reveal circuit.
+#[derive(Clone, Debug)]
+pub struct Config {
+    primary: Column<InstanceColumn>,
+    advices: [Column<Advice>; 9],
+    poseidon_configs: [PoseidonConfig<pallas::Base, 3, 2>; POSEIDON_CONFIGS],
+    merkle_swap: MerkleSwapGate,
+    q_share_comm_mux: Selector,
+    ecc_advices: [Column<Advice>; 10],
+    ecc_config: EccConfig<OrchardFixedBases>,
+    nonzero: NonZeroConfig,
+    table_idx: TableColumn,
+    /// V2 only: one-hot decision bits `b_0..b_7` (advices[0..8]) and `o` (advices[8]).
+    q_onehot: Option<Selector>,
+    /// V2 only: `out = R + b (S - R)` per coordinate on the ECC columns.
+    q_select: Option<Selector>,
+}
+
+impl Config {
+    /// Poseidon chip on configuration `i` (0 = primary, 1 = Merkle B, 2 = route C).
+    fn poseidon_chip(&self, i: usize) -> PoseidonChip<pallas::Base, 3, 2> {
+        PoseidonChip::construct(self.poseidon_configs[i].clone())
+    }
+
+    /// Assigns a constant into `advices[0]` so it is baked into the VK.
+    fn assign_constant(
+        &self,
+        layouter: &mut impl Layouter<pallas::Base>,
+        label: &'static str,
+        value: pallas::Base,
+    ) -> Result<AssignedCell<pallas::Base, pallas::Base>, plonk::Error> {
+        layouter.assign_region(
+            || label,
+            |mut region| region.assign_advice_from_constant(|| label, self.advices[0], 0, value),
+        )
+    }
+
+    /// Copies instance row `offset` into a fresh advice cell.
+    fn copy_instance(
+        &self,
+        layouter: &mut impl Layouter<pallas::Base>,
+        label: &'static str,
+        offset: usize,
+    ) -> Result<AssignedCell<pallas::Base, pallas::Base>, plonk::Error> {
+        layouter.assign_region(
+            || label,
+            |mut region| {
+                region.assign_advice_from_instance(|| label, self.primary, offset, self.advices[0], 0)
+            },
+        )
+    }
+}
+
+// ================================================================
+// Circuit
+// ================================================================
+
+/// The routed share reveal circuit. `RD` is the route tree depth. `M = 0`
+/// is the V1 shape (public `o`, one ciphertext); `M = 8` is the private-vote
+/// shape (private `o`, an `M`-bucket one-hot ciphertext vector).
+#[derive(Clone, Debug)]
+pub struct Circuit<const RD: usize = ROUTE_TREE_DEPTH, const M: usize = 0> {
+    pub(crate) vote_comm_tree_path: Value<[pallas::Base; VOTE_COMM_TREE_DEPTH]>,
+    pub(crate) vote_comm_tree_position: Value<u32>,
+    pub(crate) share_comms: [Value<pallas::Base>; 16],
+    pub(crate) primary_blind: Value<pallas::Base>,
+    pub(crate) share_index: Value<pallas::Base>,
+    pub(crate) delegation_commitment: Value<pallas::Base>,
+    pub(crate) delegate_index: Value<pallas::Base>,
+    pub(crate) enc_c1: Value<pallas::Affine>,
+    pub(crate) enc_c2: Value<pallas::Affine>,
+    pub(crate) rerandomizer: Value<pallas::Base>,
+    pub(crate) ea_pk: Value<pallas::Affine>,
+    pub(crate) route_tree_path: Value<[pallas::Base; RD]>,
+    pub(crate) route_tree_position: Value<u32>,
+    /// V2 only: the routed option (private).
+    pub(crate) vote_decision: Value<pallas::Base>,
+    /// V2 only: per-bucket re-randomizers.
+    pub(crate) bucket_rerandomizers: [Value<pallas::Base>; M],
+    /// Test-only: overrides the one-hot bits derived from `vote_decision`.
+    pub(crate) onehot_override: Option<[pallas::Base; M]>,
+}
+
+impl<const RD: usize, const M: usize> Default for Circuit<RD, M> {
+    fn default() -> Self {
+        Self {
+            vote_comm_tree_path: Value::unknown(),
+            vote_comm_tree_position: Value::unknown(),
+            share_comms: [Value::unknown(); 16],
+            primary_blind: Value::unknown(),
+            share_index: Value::unknown(),
+            delegation_commitment: Value::unknown(),
+            delegate_index: Value::unknown(),
+            enc_c1: Value::unknown(),
+            enc_c2: Value::unknown(),
+            rerandomizer: Value::unknown(),
+            ea_pk: Value::unknown(),
+            route_tree_path: Value::unknown(),
+            route_tree_position: Value::unknown(),
+            vote_decision: Value::unknown(),
+            bucket_rerandomizers: [Value::unknown(); M],
+            onehot_override: None,
+        }
+    }
+}
+
+/// VC path schedule: 8 levels on the primary config, 16 on Merkle B (as ZKP3).
+const VC_SCHEDULE: [usize; VOTE_COMM_TREE_DEPTH] = [
+    0, 1, 1, 0, 1, 1, 0, 1, 1, 0, 1, 1, 0, 1, 1, 0, 1, 1, 0, 1, 1, 0, 1, 1,
+];
+
+/// Route path schedule: every level on route config C.
+fn route_schedule<const RD: usize>() -> [usize; RD] {
+    [2; RD]
+}
+
+impl<const RD: usize, const M: usize> plonk::Circuit<pallas::Base> for Circuit<RD, M> {
+    type Config = Config;
+    type FloorPlanner = floor_planner::V1;
+
+    fn without_witnesses(&self) -> Self {
+        Self::default()
+    }
+
+    fn configure(meta: &mut ConstraintSystem<pallas::Base>) -> Self::Config {
+        let advices: [Column<Advice>; 9] = core::array::from_fn(|_| meta.advice_column());
+        for col in &advices {
+            meta.enable_equality(*col);
+        }
+        let primary = meta.instance_column();
+        meta.enable_equality(primary);
+
+        let lagrange_coeffs: [Column<Fixed>; 8] = core::array::from_fn(|_| meta.fixed_column());
+        meta.enable_constant(lagrange_coeffs[0]);
+        let poseidon_a = PoseidonChip::configure::<poseidon::P128Pow5T3>(
+            meta,
+            advices[6..9].try_into().unwrap(),
+            advices[5],
+            lagrange_coeffs[2..5].try_into().unwrap(),
+            lagrange_coeffs[5..8].try_into().unwrap(),
+        );
+
+        let merkle_advice: [Column<Advice>; 4] = core::array::from_fn(|_| meta.advice_column());
+        let merkle_rc: [Column<Fixed>; 6] = core::array::from_fn(|_| meta.fixed_column());
+        let poseidon_b = PoseidonChip::configure::<poseidon::P128Pow5T3>(
+            meta,
+            merkle_advice[1..4].try_into().unwrap(),
+            merkle_advice[0],
+            merkle_rc[..3].try_into().unwrap(),
+            merkle_rc[3..].try_into().unwrap(),
+        );
+
+        let route_advice: [Column<Advice>; 4] = core::array::from_fn(|_| meta.advice_column());
+        let route_rc: [Column<Fixed>; 6] = core::array::from_fn(|_| meta.fixed_column());
+        let poseidon_c = PoseidonChip::configure::<poseidon::P128Pow5T3>(
+            meta,
+            route_advice[1..4].try_into().unwrap(),
+            route_advice[0],
+            route_rc[..3].try_into().unwrap(),
+            route_rc[3..].try_into().unwrap(),
+        );
+
+        let merkle_swap = MerkleSwapGate::configure(
+            meta,
+            [advices[0], advices[1], advices[2], advices[3], advices[4]],
+        );
+
+        // Share commitment multiplexer, identical to ZKP3 condition 4.
+        let q_share_comm_mux = meta.selector();
+        meta.create_gate("share commitment multiplexer", |meta| {
+            let q = meta.query_selector(q_share_comm_mux);
+            // Query only the cells the layout uses (see ZKP3 condition 4).
+            let mut at = |c: usize, r: i32| meta.query_advice(advices[c], Rotation(r));
+            let mut sel: Vec<Expression<pallas::Base>> = Vec::with_capacity(16);
+            for i in 0..16 {
+                sel.push(if i < 9 { at(i, 0) } else { at(i - 9, 1) });
+            }
+            let mut comm: Vec<Expression<pallas::Base>> = Vec::with_capacity(16);
+            for i in 0..16 {
+                comm.push(match i {
+                    0 => at(7, 1),
+                    1 => at(8, 1),
+                    2..=10 => at(i - 2, 2),
+                    _ => at(i - 11, 3),
+                });
+            }
+            let selected_comm = at(5, 3);
+            let share_index = at(6, 3);
+            let one = Expression::Constant(pallas::Base::one());
+
+            let mut constraints: Vec<(&'static str, Expression<pallas::Base>)> = (0..16)
+                .map(|i| ("bool sel_i", bool_check(sel[i].clone())))
+                .collect();
+            let sum = sel.iter().skip(1).fold(sel[0].clone(), |a, s| a + s.clone());
+            constraints.push(("sum sel == 1", sum - one));
+            let reconstructed = sel.iter().enumerate().skip(1).fold(
+                Expression::Constant(pallas::Base::zero()),
+                |a, (i, s)| a + Expression::Constant(pallas::Base::from(i as u64)) * s.clone(),
+            );
+            constraints.push(("index reconstruct", share_index - reconstructed));
+            let mux = comm
+                .iter()
+                .zip_eq(sel.iter())
+                .fold(selected_comm, |a, (c, s)| a - s.clone() * c.clone());
+            constraints.push(("comm mux", mux));
+            Constraints::with_selector(q, constraints)
+        });
+
+        // ECC track (R5) on its own ten columns so it overlaps the Poseidon tracks.
+        let ecc_advices: [Column<Advice>; 10] = core::array::from_fn(|_| meta.advice_column());
+        let table_idx = meta.lookup_table_column();
+        let range_check = LookupRangeCheckConfig::<pallas::Base, RANGE_CHECK_WORD_BITS>::configure(
+            meta,
+            ecc_advices[9],
+            table_idx,
+        );
+        let ecc_lagrange: [Column<Fixed>; 8] = core::array::from_fn(|_| meta.fixed_column());
+        let ecc_config =
+            EccChip::<OrchardFixedBases>::configure(meta, ecc_advices, ecc_lagrange, range_check);
+        let nonzero = NonZeroConfig::configure(meta, [ecc_advices[0], ecc_advices[1]]);
+
+        assert!(M <= 8, "one-hot row holds at most 8 buckets");
+        let q_onehot = (M > 0).then(|| meta.selector());
+        if let Some(q_onehot) = q_onehot {
+            meta.create_gate("decision one-hot", |meta| {
+                let q = meta.query_selector(q_onehot);
+                let b: Vec<Expression<pallas::Base>> =
+                    (0..M).map(|j| meta.query_advice(advices[j], Rotation::cur())).collect();
+                let o = meta.query_advice(advices[8], Rotation::cur());
+                let mut cs: Vec<(&'static str, Expression<pallas::Base>)> =
+                    b.iter().map(|bj| ("bool b_j", bool_check(bj.clone()))).collect();
+                let sum = b.iter().skip(1).fold(b[0].clone(), |a, x| a + x.clone());
+                cs.push(("sum b == 1", sum - Expression::Constant(pallas::Base::one())));
+                let idx = b.iter().enumerate().skip(1).fold(
+                    Expression::Constant(pallas::Base::zero()),
+                    |a, (j, x)| a + Expression::Constant(pallas::Base::from(j as u64)) * x.clone(),
+                );
+                cs.push(("o == sum j b_j", o - idx));
+                Constraints::with_selector(q, cs)
+            });
+        }
+        let q_select = (M > 0).then(|| meta.selector());
+        if let Some(q_select) = q_select {
+            meta.create_gate("bucket select", |meta| {
+                let q = meta.query_selector(q_select);
+                let mut a = |i: usize| meta.query_advice(ecc_advices[i], Rotation::cur());
+                let (b, rx, ry, sx, sy, ox, oy) = (a(0), a(1), a(2), a(3), a(4), a(5), a(6));
+                Constraints::with_selector(
+                    q,
+                    [
+                        ("bool b", bool_check(b.clone())),
+                        ("out x", ox - rx.clone() - b.clone() * (sx - rx)),
+                        ("out y", oy - ry.clone() - b * (sy - ry)),
+                    ],
+                )
+            });
+        }
+
+        Config {
+            primary,
+            advices,
+            poseidon_configs: [poseidon_a, poseidon_b, poseidon_c],
+            merkle_swap,
+            q_share_comm_mux,
+            ecc_advices,
+            ecc_config,
+            nonzero,
+            table_idx,
+            q_onehot,
+            q_select,
+        }
+    }
+
+    fn synthesize(
+        &self,
+        config: Self::Config,
+        mut layouter: impl Layouter<pallas::Base>,
+    ) -> Result<(), plonk::Error> {
+        // 10-bit range-check table used by the ECC chip's decompositions.
+        layouter.assign_table(
+            || "range check table",
+            |mut table| {
+                for i in 0..(1usize << RANGE_CHECK_WORD_BITS) {
+                    table.assign_cell(
+                        || "table_idx",
+                        config.table_idx,
+                        i,
+                        || Value::known(pallas::Base::from(i as u64)),
+                    )?;
+                }
+                Ok(())
+            },
+        )?;
+
+        let adv0 = config.advices[0];
+        let dc = assign_free_advice(layouter.namespace(|| "witness dc"), adv0, self.delegation_commitment)?;
+        let share_index = assign_free_advice(layouter.namespace(|| "witness share_index"), adv0, self.share_index)?;
+        let blind = assign_free_advice(layouter.namespace(|| "witness blind"), adv0, self.primary_blind)?;
+        let d = assign_free_advice(layouter.namespace(|| "witness d"), adv0, self.delegate_index)?;
+
+        let (p_off, vc_root_off, round_off, ea_x_off, ea_y_off, route_root_off) = if M == 0 {
+            (
+                PROPOSAL_ID_OFFSET,
+                VOTE_COMM_TREE_ROOT_OFFSET,
+                VOTING_ROUND_ID_OFFSET,
+                EA_PK_X_OFFSET,
+                EA_PK_Y_OFFSET,
+                ROUTE_TREE_ROOT_OFFSET,
+            )
+        } else {
+            v2_offsets(M)
+        };
+        // V1: `o` is public. V2: `o` is private and decomposed one-hot.
+        let (vote_decision, onehot) = if M == 0 {
+            (config.copy_instance(&mut layouter, "vote_decision", VOTE_DECISION_OFFSET)?, Vec::new())
+        } else {
+            layouter.assign_region(
+                || "V2 decision one-hot",
+                |mut region| {
+                    config.q_onehot.expect("M > 0").enable(&mut region, 0)?;
+                    let mut bits = Vec::with_capacity(M);
+                    for j in 0..M {
+                        bits.push(region.assign_advice(
+                            || format!("b_{j}"),
+                            config.advices[j],
+                            0,
+                            || match &self.onehot_override {
+                                Some(bits) => Value::known(bits[j]),
+                                None => self.vote_decision.map(|o| {
+                                    if o == pallas::Base::from(j as u64) {
+                                        pallas::Base::one()
+                                    } else {
+                                        pallas::Base::zero()
+                                    }
+                                }),
+                            },
+                        )?);
+                    }
+                    let o = region.assign_advice(|| "o", config.advices[8], 0, || self.vote_decision)?;
+                    Ok((o, bits))
+                },
+            )?
+        };
+        let round = config.copy_instance(&mut layouter, "voting_round_id", round_off)?;
+        let proposal_id = config.copy_instance(&mut layouter, "proposal_id", p_off)?;
+
+        // R3: shares_hash from the 16 private share commitments.
+        let share_comms: [AssignedCell<pallas::Base, pallas::Base>; 16] = {
+            let mut cells = Vec::with_capacity(16);
+            for i in 0..16 {
+                cells.push(assign_free_advice(
+                    layouter.namespace(|| format!("witness share_comm[{i}]")),
+                    adv0,
+                    self.share_comms[i],
+                )?);
+            }
+            cells.try_into().unwrap()
+        };
+        let shares_hash = compute_shares_hash_from_comms_in_circuit(
+            config.poseidon_chip(0),
+            layouter.namespace(|| "R3 shares_hash"),
+            share_comms.clone(),
+        )?;
+
+        // R4/R5 inputs: ECC witnesses for ea_pk and the original ciphertext.
+        let ecc_chip = EccChip::construct(config.ecc_config.clone(), CircuitVersion::AnchoredBase);
+        let ea_pk = NonIdentityPoint::new(ecc_chip.clone(), layouter.namespace(|| "ea_pk"), self.ea_pk)?;
+        layouter.constrain_instance(ea_pk.inner().x().cell(), config.primary, ea_x_off)?;
+        layouter.constrain_instance(ea_pk.inner().y().cell(), config.primary, ea_y_off)?;
+        let c1 = NonIdentityPoint::new(ecc_chip.clone(), layouter.namespace(|| "C1"), self.enc_c1)?;
+        let c2 = NonIdentityPoint::new(ecc_chip.clone(), layouter.namespace(|| "C2"), self.enc_c2)?;
+
+        // R4: the private ciphertext opens share_comms[share_index].
+        let derived_comm = hash_share_commitment_in_circuit(
+            config.poseidon_chip(0),
+            layouter.namespace(|| "R4 Poseidon(blind, c1_x, c2_x, c1_y, c2_y)"),
+            blind.clone(),
+            c1.inner().x(),
+            c2.inner().x(),
+            c1.inner().y(),
+            c2.inner().y(),
+            0,
+        )?;
+        let selected_comm = layouter.assign_region(
+            || "R4 share commitment mux",
+            |mut region| {
+                config.q_share_comm_mux.enable(&mut region, 0)?;
+                let sel: [Value<pallas::Base>; 16] = core::array::from_fn(|i| {
+                    self.share_index.map(|idx| {
+                        if idx == pallas::Base::from(i as u64) {
+                            pallas::Base::one()
+                        } else {
+                            pallas::Base::zero()
+                        }
+                    })
+                });
+                for (start, count, col, row) in [(0, 9, 0, 0), (9, 7, 0, 1)] {
+                    for i in 0..count {
+                        region.assign_advice(
+                            || format!("sel_{}", start + i),
+                            config.advices[col + i],
+                            row,
+                            || sel[start + i],
+                        )?;
+                    }
+                }
+                for (start, count, col, row) in [(0, 2, 7, 1), (2, 9, 0, 2), (11, 5, 0, 3)] {
+                    for i in 0..count {
+                        share_comms[start + i].copy_advice(
+                            || format!("comm_{}", start + i),
+                            &mut region,
+                            config.advices[col + i],
+                            row,
+                        )?;
+                    }
+                }
+                let val = (0..16).fold(Value::known(pallas::Base::zero()), |acc, i| {
+                    acc.zip(sel[i])
+                        .zip(share_comms[i].value().copied())
+                        .map(|((a, s), c)| a + s * c)
+                });
+                let selected = region.assign_advice(|| "selected_comm", config.advices[5], 3, || val)?;
+                share_index.copy_advice(|| "share_index", &mut region, config.advices[6], 3)?;
+                Ok(selected)
+            },
+        )?;
+        layouter.assign_region(
+            || "R4 derived == selected",
+            |mut region| region.constrain_equal(derived_comm.cell(), selected_comm.cell()),
+        )?;
+
+        // R2: DC = Poseidon(DOMAIN_VC, round, shares_hash, 0, d).
+        let domain_vc = config.assign_constant(
+            &mut layouter,
+            "R2 DOMAIN_VC",
+            pallas::Base::from(vote_commitment::DOMAIN_VC),
+        )?;
+        let pool_proposal = config.assign_constant(&mut layouter, "R2 proposal 0", pallas::Base::zero())?;
+        let derived_dc = vote_commitment::vote_commitment_poseidon(
+            &config.poseidon_configs[0],
+            &mut layouter,
+            "R2",
+            domain_vc,
+            round.clone(),
+            shares_hash,
+            pool_proposal,
+            d.clone(),
+        )?;
+        layouter.assign_region(
+            || "R2 dc equality",
+            |mut region| region.constrain_equal(derived_dc.cell(), dc.cell()),
+        )?;
+
+        // R1: DC membership in the vote commitment tree.
+        let vc_root = synthesize_poseidon_merkle_path_with_config_schedule::<
+            VOTE_COMM_TREE_DEPTH,
+            POSEIDON_CONFIGS,
+        >(
+            &config.merkle_swap,
+            &config.poseidon_configs,
+            &VC_SCHEDULE,
+            &mut layouter,
+            adv0,
+            dc.clone(),
+            self.vote_comm_tree_position,
+            self.vote_comm_tree_path,
+            "R1 merkle",
+        )?;
+        layouter.constrain_instance(vc_root.cell(), config.primary, vc_root_off)?;
+
+        // R6: route leaf (d, p, o) in the route tree.
+        let domain_route =
+            config.assign_constant(&mut layouter, "R6 DOMAIN_ROUTE", pallas::Base::from(DOMAIN_ROUTE))?;
+        let route_leaf = poseidon_hash_in_circuit(
+            config.poseidon_chip(2),
+            layouter.namespace(|| "R6 route leaf"),
+            "Poseidon(DOMAIN_ROUTE, round, d, p, o)",
+            [domain_route, round, d, proposal_id.clone(), vote_decision],
+        )?;
+        let route_root = synthesize_poseidon_merkle_path_with_config_schedule::<RD, POSEIDON_CONFIGS>(
+            &config.merkle_swap,
+            &config.poseidon_configs,
+            &route_schedule::<RD>(),
+            &mut layouter,
+            adv0,
+            route_leaf,
+            self.route_tree_position,
+            self.route_tree_path,
+            "R6 merkle",
+        )?;
+        layouter.constrain_instance(route_root.cell(), config.primary, route_root_off)?;
+
+        if M == 0 {
+            // R5: C' = C + (r'G, r' ea_pk), r' != 0.
+            let r = assign_free_advice(
+                layouter.namespace(|| "witness r'"),
+                config.ecc_advices[0],
+                self.rerandomizer,
+            )?;
+            config
+                .nonzero
+                .constrain_nonzero(layouter.namespace(|| "r' != 0"), "re-randomizer != 0", &r)?;
+            let r_g = FixedPointBaseField::from_inner(ecc_chip.clone(), OrchardBaseFieldBases::SpendAuthGBase)
+                .mul(layouter.namespace(|| "[r']G"), r.clone())?;
+            let r_scalar = ScalarVar::from_base(ecc_chip.clone(), layouter.namespace(|| "r' scalar"), &r)?;
+            let (r_pk, _) = ea_pk.mul(layouter.namespace(|| "[r']ea_pk"), r_scalar)?;
+            let c1p = c1.add(layouter.namespace(|| "C1' = C1 + [r']G"), &r_g)?;
+            let c2p = c2.add(layouter.namespace(|| "C2' = C2 + [r']ea_pk"), &r_pk)?;
+            layouter.constrain_instance(c1p.inner().x().cell(), config.primary, C1_X_OFFSET)?;
+            layouter.constrain_instance(c1p.inner().y().cell(), config.primary, C1_Y_OFFSET)?;
+            layouter.constrain_instance(c2p.inner().x().cell(), config.primary, C2_X_OFFSET)?;
+            layouter.constrain_instance(c2p.inner().y().cell(), config.primary, C2_Y_OFFSET)?;
+        } else {
+            // R5 (V2): bucket j gets R_j = Enc(0; r_j); bucket o also adds C.
+            // out_j = R_j + b_j (R_j + C - R_j), per coordinate, per point.
+            for j in 0..M {
+                let r = assign_free_advice(
+                    layouter.namespace(|| format!("witness r_{j}")),
+                    config.ecc_advices[0],
+                    self.bucket_rerandomizers[j],
+                )?;
+                config
+                    .nonzero
+                    .constrain_nonzero(layouter.namespace(|| format!("r_{j} != 0")), "bucket r != 0", &r)?;
+                let r_g = FixedPointBaseField::from_inner(ecc_chip.clone(), OrchardBaseFieldBases::SpendAuthGBase)
+                    .mul(layouter.namespace(|| format!("[r_{j}]G")), r.clone())?;
+                let r_scalar = ScalarVar::from_base(ecc_chip.clone(), layouter.namespace(|| format!("r_{j} scalar")), &r)?;
+                let (r_pk, _) = ea_pk.mul(layouter.namespace(|| format!("[r_{j}]ea_pk")), r_scalar)?;
+                let base_off = 1 + 4 * j;
+                // (point R, original C, instance offsets for x and y)
+                for (k, (rpt, c, x_off, y_off)) in [
+                    (r_g, &c1, base_off, base_off + 2),
+                    (r_pk, &c2, base_off + 1, base_off + 3),
+                ]
+                .into_iter()
+                .enumerate()
+                {
+                    let s_pt = c.add(layouter.namespace(|| format!("S_{j}{k} = R + C")), &rpt)?;
+                    let (ox, oy) = layouter.assign_region(
+                        || format!("bucket {j} select {k}"),
+                        |mut region| {
+                            config.q_select.expect("M > 0").enable(&mut region, 0)?;
+                            let ea = &config.ecc_advices;
+                            let b = onehot[j].copy_advice(|| "b", &mut region, ea[0], 0)?;
+                            let rx = rpt.inner().x().copy_advice(|| "rx", &mut region, ea[1], 0)?;
+                            let ry = rpt.inner().y().copy_advice(|| "ry", &mut region, ea[2], 0)?;
+                            let sx = s_pt.inner().x().copy_advice(|| "sx", &mut region, ea[3], 0)?;
+                            let sy = s_pt.inner().y().copy_advice(|| "sy", &mut region, ea[4], 0)?;
+                            let pick = |r: &AssignedCell<pallas::Base, pallas::Base>,
+                                        s: &AssignedCell<pallas::Base, pallas::Base>| {
+                                r.value()
+                                    .copied()
+                                    .zip(s.value().copied())
+                                    .zip(b.value().copied())
+                                    .map(|((r, s), b)| r + b * (s - r))
+                            };
+                            let ox = region.assign_advice(|| "ox", ea[5], 0, || pick(&rx, &sx))?;
+                            let oy = region.assign_advice(|| "oy", ea[6], 0, || pick(&ry, &sy))?;
+                            Ok((ox, oy))
+                        },
+                    )?;
+                    layouter.constrain_instance(ox.cell(), config.primary, x_off)?;
+                    layouter.constrain_instance(oy.cell(), config.primary, y_off)?;
+                }
+            }
+        }
+
+        // R7: nullifier per (DC, share, proposal).
+        let tag = config.assign_constant(
+            &mut layouter,
+            "R7 routed share spend tag",
+            domain_tag_routed_share_spend(),
+        )?;
+        let nf = poseidon_hash_in_circuit(
+            config.poseidon_chip(0),
+            layouter.namespace(|| "R7 nullifier"),
+            "Poseidon(tag, dc, idx, blind, p)",
+            [tag, dc, share_index, blind, proposal_id],
+        )?;
+        layouter.constrain_instance(nf.cell(), config.primary, NULLIFIER_OFFSET)?;
+        Ok(())
+    }
+}
+
+// ================================================================
+// Instance
+// ================================================================
+
+/// Public inputs (12). The first nine keep ZKP3's offsets.
+#[derive(Clone, Debug)]
+pub struct Instance {
+    pub nullifier: pallas::Base,
+    pub c1: pallas::Affine,
+    pub c2: pallas::Affine,
+    pub proposal_id: pallas::Base,
+    pub vote_decision: pallas::Base,
+    pub vote_comm_tree_root: pallas::Base,
+    pub voting_round_id: pallas::Base,
+    pub ea_pk: pallas::Affine,
+    pub route_tree_root: pallas::Base,
+}
+
+impl Instance {
+    /// Number of public inputs.
+    pub const NUM_PUBLIC_INPUTS: usize = 12;
+
+    /// Serializes public inputs in offset order.
+    pub fn to_halo2_instance(&self) -> Vec<vesta::Scalar> {
+        use voting_crypto_deps::pasta_curves::arithmetic::CurveAffine;
+        let xy = |p: &pallas::Affine| {
+            let c = p.coordinates().into_option().expect("non-identity public point");
+            (*c.x(), *c.y())
+        };
+        let (c1x, c1y) = xy(&self.c1);
+        let (c2x, c2y) = xy(&self.c2);
+        let (ex, ey) = xy(&self.ea_pk);
+        let v = vec![
+            self.nullifier,
+            c1x,
+            c1y,
+            c2x,
+            c2y,
+            self.proposal_id,
+            self.vote_decision,
+            self.vote_comm_tree_root,
+            self.voting_round_id,
+            ex,
+            ey,
+            self.route_tree_root,
+        ];
+        debug_assert_eq!(v.len(), Self::NUM_PUBLIC_INPUTS);
+        v
+    }
+}
+
+/// Public inputs for the private-vote (V2) shape: no `o`; one ciphertext per
+/// bucket, `o`'s bucket carrying the re-randomized share.
+#[derive(Clone, Debug)]
+pub struct InstanceV2 {
+    pub nullifier: pallas::Base,
+    pub buckets: Vec<(pallas::Affine, pallas::Affine)>,
+    pub proposal_id: pallas::Base,
+    pub vote_comm_tree_root: pallas::Base,
+    pub voting_round_id: pallas::Base,
+    pub ea_pk: pallas::Affine,
+    pub route_tree_root: pallas::Base,
+}
+
+impl InstanceV2 {
+    /// Serializes public inputs in `v2_offsets` order.
+    pub fn to_halo2_instance(&self) -> Vec<vesta::Scalar> {
+        use voting_crypto_deps::pasta_curves::arithmetic::CurveAffine;
+        let xy = |p: &pallas::Affine| {
+            let c = p.coordinates().into_option().expect("non-identity public point");
+            (*c.x(), *c.y())
+        };
+        let mut v = vec![self.nullifier];
+        for (c1, c2) in &self.buckets {
+            let ((c1x, c1y), (c2x, c2y)) = (xy(c1), xy(c2));
+            v.extend([c1x, c2x, c1y, c2y]);
+        }
+        let (ex, ey) = xy(&self.ea_pk);
+        v.extend([self.proposal_id, self.vote_comm_tree_root, self.voting_round_id, ex, ey, self.route_tree_root]);
+        v
+    }
+}
