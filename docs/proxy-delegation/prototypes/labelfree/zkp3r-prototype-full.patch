+// ----------------------------------------------------------------
+// ECC probe (ignored): rows for N re-randomizations on T ECC tracks, to
+// size a private-vote (V2) variant that emits an 8-bucket one-hot vector.
+// Each bucket j: r_j != 0, R1 = [r_j]G, R2 = [r_j]ea_pk, S = R + C
+// (complete add), out = R + b_j (S - R) coordinate-wise (as ZKP 1.5).
+// ----------------------------------------------------------------
+
+mod ecc_probe {
+    use super::*;
+    use crate::gadgets::nonzero::NonZeroConfig;
+    use crate::params::RANGE_CHECK_WORD_BITS;
+    use voting_crypto_deps::halo2_gadgets::{
+        ecc::{chip::{EccChip, EccConfig}, CircuitVersion, FixedPointBaseField, NonIdentityPoint, ScalarVar},
+        utilities::lookup_range_check::{LookupRangeCheck, LookupRangeCheckConfig},
+    };
+    use voting_crypto_deps::halo2_proofs::{
+        circuit::{floor_planner, Layouter},
+        plonk::{self, Advice, Column, ConstraintSystem, Constraints, Fixed, Selector, TableColumn},
+        poly::Rotation,
+    };
+    use voting_crypto_deps::orchard::{
+        circuit::gadget::assign_free_advice,
+        constants::{OrchardBaseFieldBases, OrchardFixedBases},
+    };
+
+    #[derive(Clone, Debug)]
+    pub struct Cfg<const T: usize> {
+        ecc: Vec<(EccConfig<OrchardFixedBases>, NonZeroConfig, [Column<Advice>; 10], Selector)>,
+        table: TableColumn,
+    }
+
+    /// `N` buckets spread round-robin over `T` ECC tracks.
+    #[derive(Clone, Debug)]
+    pub struct Probe<const N: usize, const T: usize> {
+        pub ea_pk: Value<pallas::Affine>,
+        pub c1: Value<pallas::Affine>,
+        pub c2: Value<pallas::Affine>,
+        pub r: [Value<pallas::Base>; N],
+        pub sel: [Value<pallas::Base>; N],
+    }
+
+    impl<const N: usize, const T: usize> Default for Probe<N, T> {
+        fn default() -> Self {
+            Self {
+                ea_pk: Value::unknown(),
+                c1: Value::unknown(),
+                c2: Value::unknown(),
+                r: [Value::unknown(); N],
+                sel: [Value::unknown(); N],
+            }
+        }
+    }
+
+    impl<const N: usize, const T: usize> plonk::Circuit<pallas::Base> for Probe<N, T> {
+        type Config = Cfg<T>;
+        type FloorPlanner = floor_planner::V1;
+        fn without_witnesses(&self) -> Self {
+            Self::default()
+        }
+        fn configure(meta: &mut ConstraintSystem<pallas::Base>) -> Cfg<T> {
+            let consts = meta.fixed_column();
+            meta.enable_constant(consts);
+            let table = meta.lookup_table_column();
+            let ecc = (0..T)
+                .map(|_| {
+                    let adv: [Column<Advice>; 10] = core::array::from_fn(|_| meta.advice_column());
+                    let lag: [Column<Fixed>; 8] = core::array::from_fn(|_| meta.fixed_column());
+                    let rc = LookupRangeCheckConfig::<pallas::Base, RANGE_CHECK_WORD_BITS>::configure(meta, adv[9], table);
+                    let cfg = EccChip::<OrchardFixedBases>::configure(meta, adv, lag, rc);
+                    let nz = NonZeroConfig::configure(meta, [adv[0], adv[1]]);
+                    // out = R + b (S - R) for x and y; b boolean.
+                    let q = meta.selector();
+                    meta.create_gate("bucket select", |m| {
+                        let q = m.query_selector(q);
+                        let b = m.query_advice(adv[0], Rotation::cur());
+                        let (rx, ry, sx, sy, ox, oy) = (
+                            m.query_advice(adv[1], Rotation::cur()),
+                            m.query_advice(adv[2], Rotation::cur()),
+                            m.query_advice(adv[3], Rotation::cur()),
+                            m.query_advice(adv[4], Rotation::cur()),
+                            m.query_advice(adv[5], Rotation::cur()),
+                            m.query_advice(adv[6], Rotation::cur()),
+                        );
+                        Constraints::with_selector(
+                            q,
+                            [
+                                ("bool b", b.clone() * (b.clone() - voting_crypto_deps::halo2_proofs::plonk::Expression::Constant(pallas::Base::one()))),
+                                ("x", ox - rx.clone() - b.clone() * (sx - rx)),
+                                ("y", oy - ry.clone() - b * (sy - ry)),
+                            ],
+                        )
+                    });
+                    (cfg, nz, adv, q)
+                })
+                .collect();
+            Cfg { ecc, table }
+        }
+        fn synthesize(&self, cfg: Cfg<T>, mut layouter: impl Layouter<pallas::Base>) -> Result<(), plonk::Error> {
+            layouter.assign_table(|| "table", |mut t| {
+                for i in 0..1024usize {
+                    t.assign_cell(|| "i", cfg.table, i, || Value::known(pallas::Base::from(i as u64)))?;
+                }
+                Ok(())
+            })?;
+            for j in 0..N {
+                let (ecc_cfg, nz, adv, q) = &cfg.ecc[j % T];
+                let chip = EccChip::construct(ecc_cfg.clone(), CircuitVersion::AnchoredBase);
+                // Per-track witnesses (copy-constrained in a real circuit).
+                let ea_pk = NonIdentityPoint::new(chip.clone(), layouter.namespace(|| "ea_pk"), self.ea_pk)?;
+                let c = [
+                    NonIdentityPoint::new(chip.clone(), layouter.namespace(|| "c1"), self.c1)?,
+                    NonIdentityPoint::new(chip.clone(), layouter.namespace(|| "c2"), self.c2)?,
+                ];
+                let r = assign_free_advice(layouter.namespace(|| "r"), adv[0], self.r[j])?;
+                nz.constrain_nonzero(layouter.namespace(|| "r!=0"), "r != 0", &r)?;
+                let rg = FixedPointBaseField::from_inner(chip.clone(), OrchardBaseFieldBases::SpendAuthGBase)
+                    .mul(layouter.namespace(|| "rG"), r.clone())?;
+                let rs = ScalarVar::from_base(chip.clone(), layouter.namespace(|| "rs"), &r)?;
+                let (rp, _) = ea_pk.mul(layouter.namespace(|| "r pk"), rs)?;
+                for (k, rpt) in [rg, rp].into_iter().enumerate() {
+                    let s = c[k].add(layouter.namespace(|| "S = R + C"), &rpt)?;
+                    layouter.assign_region(|| "select", |mut region| {
+                        q.enable(&mut region, 0)?;
+                        region.assign_advice(|| "b", adv[0], 0, || self.sel[j])?;
+                        let rx = rpt.inner().x().copy_advice(|| "rx", &mut region, adv[1], 0)?;
+                        let ry = rpt.inner().y().copy_advice(|| "ry", &mut region, adv[2], 0)?;
+                        let sx = s.inner().x().copy_advice(|| "sx", &mut region, adv[3], 0)?;
+                        let sy = s.inner().y().copy_advice(|| "sy", &mut region, adv[4], 0)?;
+                        let pick = |r: &AssignedCellB, s: &AssignedCellB| {
+                            r.value().copied().zip(s.value().copied()).zip(self.sel[j]).map(|((r, s), b)| r + b * (s - r))
+                        };
+                        region.assign_advice(|| "ox", adv[5], 0, || pick(&rx, &sx))?;
+                        region.assign_advice(|| "oy", adv[6], 0, || pick(&ry, &sy))?;
+                        Ok(())
+                    })?;
+                }
+            }
+            Ok(())
+        }
+    }
+
+    type AssignedCellB = voting_crypto_deps::halo2_proofs::circuit::AssignedCell<pallas::Base, pallas::Base>;
+
+    fn probe<const N: usize, const T: usize>() -> Probe<N, T> {
+        let (_, ea_pk) = ea_keypair();
+        let b = base();
+        let i = Fx::default().share_index;
+        Probe {
+            ea_pk: Value::known(ea_pk),
+            c1: Value::known(b.c1[i]),
+            c2: Value::known(b.c2[i]),
+            r: core::array::from_fn(|j| Value::known(pallas::Base::from(1000 + j as u64))),
+            sel: core::array::from_fn(|j| Value::known(if j == 3 { pallas::Base::one() } else { pallas::Base::zero() })),
+        }
+    }
+
+    fn measure<const N: usize, const T: usize>() {
+        use voting_crypto_deps::halo2_proofs::dev::CircuitCost;
+        use voting_crypto_deps::pasta_curves::vesta;
+        let c = probe::<N, T>();
+        let mut kmin = 0;
+        for k in 10..=14u32 {
+            if let Ok(p) = MockProver::run(k, &c, vec![]) {
+                if p.verify().is_ok() {
+                    kmin = k;
+                    break;
+                }
+            }
+        }
+        let cost = CircuitCost::<vesta::Point, _>::measure(kmin.max(11), &c);
+        let d = format!("{cost:?}");
+        let ex = |f: &str| d.split(&format!("{f}: ")).nth(1).and_then(|s| s.split([',', ' ']).next()).unwrap_or("?").to_string();
+        println!(
+            "ECC probe N={N} buckets, T={T} tracks: min K {kmin}; max_advice_rows {}; advice cols {}; fixed cols {}",
+            ex("max_advice_rows"), ex("num_advice_columns"), ex("num_fixed_columns")
+        );
+    }
+
+    #[test]
+    #[ignore = "diagnostic"]
+    fn ecc_probe_rows() {
+        measure::<1, 1>();
+        measure::<2, 1>();
+        measure::<4, 1>();
+        measure::<8, 1>();
+        measure::<8, 2>();
+        measure::<8, 4>();
+    }
+}
+
+
+// ----------------------------------------------------------------
+// Private-vote (V2) shape: private o, 8-bucket one-hot output.
+// ----------------------------------------------------------------
+
+mod v2 {
+    use super::*;
+
+    pub(crate) struct BuiltV2 {
+        pub circuit: Circuit<ROUTE_TREE_DEPTH, V2_BUCKETS>,
+        pub instance: InstanceV2,
+        pub base: Built<ROUTE_TREE_DEPTH>,
+    }
+
+    /// Native V2 output: bucket j = Enc(0; r_j), plus C in bucket o.
+    pub(crate) fn v2_buckets(
+        c1: pallas::Affine,
+        c2: pallas::Affine,
+        o: usize,
+        r: &[pallas::Base; V2_BUCKETS],
+        ea_pk: pallas::Affine,
+    ) -> Vec<(pallas::Affine, pallas::Affine)> {
+        (0..V2_BUCKETS)
+            .map(|j| {
+                let rs = base_to_scalar(r[j]).unwrap();
+                let r1 = spend_auth_g_affine() * rs;
+                let r2 = ea_pk * rs;
+                if j == o {
+                    ((r1 + c1).to_affine(), (r2 + c2).to_affine())
+                } else {
+                    (r1.to_affine(), r2.to_affine())
+                }
+            })
+            .collect()
+    }
+
+    pub(crate) fn rs(seed: u64) -> [pallas::Base; V2_BUCKETS] {
+        core::array::from_fn(|j| pallas::Base::from(seed * 1000 + j as u64 + 1))
+    }
+
+    pub(crate) fn build_v2(fx: &Fx) -> BuiltV2 {
+        let b = build::<ROUTE_TREE_DEPTH>(fx);
+        let (_, ea_pk) = ea_keypair();
+        let r = rs(7);
+        let i = fx.share_index;
+        let c = &b.circuit;
+        let circuit = Circuit::<ROUTE_TREE_DEPTH, V2_BUCKETS> {
+            vote_comm_tree_path: c.vote_comm_tree_path,
+            vote_comm_tree_position: c.vote_comm_tree_position,
+            share_comms: c.share_comms,
+            primary_blind: c.primary_blind,
+            share_index: c.share_index,
+            delegation_commitment: c.delegation_commitment,
+            delegate_index: c.delegate_index,
+            enc_c1: c.enc_c1,
+            enc_c2: c.enc_c2,
+            rerandomizer: Value::unknown(),
+            ea_pk: c.ea_pk,
+            route_tree_path: c.route_tree_path,
+            route_tree_position: c.route_tree_position,
+            vote_decision: Value::known(pallas::Base::from(fx.o)),
+            bucket_rerandomizers: r.map(Value::known),
+            onehot_override: None,
+        };
+        let instance = InstanceV2 {
+            nullifier: b.instance.nullifier,
+            buckets: v2_buckets(b.c1[i], b.c2[i], fx.o as usize, &r, ea_pk),
+            proposal_id: b.instance.proposal_id,
+            vote_comm_tree_root: b.instance.vote_comm_tree_root,
+            voting_round_id: b.instance.voting_round_id,
+            ea_pk,
+            route_tree_root: b.instance.route_tree_root,
+        };
+        BuiltV2 { circuit, instance, base: b }
+    }
+
+    fn okv2(c: &Circuit<ROUTE_TREE_DEPTH, V2_BUCKETS>, i: &InstanceV2) -> bool {
+        match mock(c, &i.to_halo2_instance()) {
+            Ok(()) => true,
+            Err(e) => {
+                println!("    rejected: {}", &e[..e.len().min(300)]);
+                false
+            }
+        }
+    }
+
+    #[test]
+    fn zkp3r_v2_valid_and_decrypts_one_hot() {
+        let b = build_v2(&Fx::default());
+        mock(&b.circuit, &b.instance.to_halo2_instance()).unwrap();
+        let fx = Fx::default();
+        for (j, (c1, c2)) in b.instance.buckets.iter().enumerate() {
+            let m = decrypt(b.base.ea_sk, *c1, *c2);
+            let v = if j == fx.o as usize { fx.shares[fx.share_index] } else { 0 };
+            assert_eq!(m, spend_auth_g_affine() * pallas::Scalar::from(v), "bucket {j}");
+        }
+        // Another routed proposal: p=4 -> o=0 (leaf 4); distinct nullifier.
+        let b4 = build_v2(&Fx { p: 4, o: 0, route_open: 4, ..Fx::default() });
+        mock(&b4.circuit, &b4.instance.to_halo2_instance()).unwrap();
+        assert_ne!(b4.instance.nullifier, b.instance.nullifier);
+        assert_eq!(b.instance.to_halo2_instance().len(), 1 + 4 * V2_BUCKETS + 6);
+    }
+
+    #[test]
+    fn zkp3r_v2_rejects_wrong_bucket_or_route() {
+        let fx = Fx::default(); // route (17, 3, 1)
+        let (_, ea_pk) = ea_keypair();
+        let i = fx.share_index;
+        // (a) Private o = 2, share placed in bucket 2: no route (17, 3, 2).
+        let mut b = build_v2(&fx);
+        b.circuit.vote_decision = Value::known(pallas::Base::from(2u64));
+        b.instance.buckets = v2_buckets(b.base.c1[i], b.base.c2[i], 2, &rs(7), ea_pk);
+        assert!(!okv2(&b.circuit, &b.instance), "o not routed");
+        // (b) Honest o = 1 in the witness, but the public vector carries the share in bucket 2.
+        let mut b = build_v2(&fx);
+        b.instance.buckets = v2_buckets(b.base.c1[i], b.base.c2[i], 2, &rs(7), ea_pk);
+        assert!(!okv2(&b.circuit, &b.instance), "public bucket != routed o");
+        // (c) Two buckets carry the share (not one-hot).
+        let mut b = build_v2(&fx);
+        let mut bits = [pallas::Base::zero(); V2_BUCKETS];
+        bits[1] = pallas::Base::one();
+        bits[2] = pallas::Base::one();
+        b.circuit.onehot_override = Some(bits);
+        let mut v = v2_buckets(b.base.c1[i], b.base.c2[i], 1, &rs(7), ea_pk);
+        let both = v2_buckets(b.base.c1[i], b.base.c2[i], 2, &rs(7), ea_pk);
+        v[2] = both[2];
+        b.instance.buckets = v;
+        assert!(!okv2(&b.circuit, &b.instance), "two buckets");
+        // (d) Zero buckets carry the share (all Enc(0)): sum b == 1 fails.
+        let mut b = build_v2(&fx);
+        b.circuit.onehot_override = Some([pallas::Base::zero(); V2_BUCKETS]);
+        b.instance.buckets = v2_buckets(b.base.c1[i], b.base.c2[i], 99, &rs(7), ea_pk);
+        assert!(!okv2(&b.circuit, &b.instance), "no bucket");
+        // (e) Delegate 9's route (9, 3, 1) cannot carry delegate 17's DC.
+        let b = build_v2(&Fx { route_open: 2, ..fx.clone() });
+        assert!(!okv2(&b.circuit, &b.instance), "other delegate's route");
+        // (f) Bucket order swapped in the public vector.
+        let mut b = build_v2(&fx);
+        b.instance.buckets.swap(1, 5);
+        assert!(!okv2(&b.circuit, &b.instance), "swapped buckets");
+        // (g) Forged plaintext in bucket o (share + 1).
+        let mut b = build_v2(&fx);
+        let (c1, c2) = b.instance.buckets[1];
+        b.instance.buckets[1] = (c1, (c2 + spend_auth_g_affine()).to_affine());
+        assert!(!okv2(&b.circuit, &b.instance), "plaintext + 1");
+    }
+
+    #[test]
+    #[ignore = "diagnostic"]
+    fn zkp3r_v2_row_budget() {
+        let b = build_v2(&Fx::default());
+        let (rows, adv, fixed, dbg) = cost_rows(K, &b.circuit);
+        let (rows_d, _, _, _) = cost_rows(K, &Circuit::<ROUTE_TREE_DEPTH, V2_BUCKETS>::default());
+        println!("=== ZKP3R-V2 (8 buckets, route depth {ROUTE_TREE_DEPTH}) ===");
+        println!("  max_rows {rows}, max_advice_rows {adv}, max_fixed_rows {fixed}; default {rows_d} ({})", if rows == rows_d { "witness-independent" } else { "MISMATCH" });
+        println!("  debug: {}", dbg.split("_marker").next().unwrap());
+        for k in 10..=12u32 {
+            let r = match MockProver::run(k, &b.circuit, vec![b.instance.to_halo2_instance()]) {
+                Err(e) => format!("synthesis rejected ({e:?})"),
+                Ok(p) => match p.verify() { Ok(()) => "PASS".into(), Err(e) => format!("{} failures", e.len()) },
+            };
+            println!("  K={k}: {r}");
+        }
+    }
+
+    #[test]
+    #[ignore = "release timing"]
+    fn zkp3r_v2_prove_verify_timing() {
+        use std::time::Instant;
+        let n: usize = std::env::var("ZKP3R_N").ok().and_then(|s| s.parse().ok()).unwrap_or(10);
+        let t = Instant::now();
+        let keys = super::super::prove::keygen::<ROUTE_TREE_DEPTH, V2_BUCKETS>().unwrap();
+        let keygen_ms = t.elapsed().as_secs_f64() * 1e3;
+        let b = build_v2(&Fx::default());
+        let pi = b.instance.to_halo2_instance();
+        let mut proof = Vec::new();
+        let mut prove_ms = Vec::new();
+        for _ in 0..n {
+            let t = Instant::now();
+            proof = super::super::prove::prove(&keys, b.circuit.clone(), &pi).unwrap();
+            prove_ms.push(t.elapsed().as_secs_f64() * 1e3);
+        }
+        let mut verify_ms = Vec::new();
+        for _ in 0..n {
+            let t = Instant::now();
+            super::super::prove::verify(&keys, &proof, &pi).unwrap();
+            verify_ms.push(t.elapsed().as_secs_f64() * 1e3);
+        }
+        let mut swapped = b.instance.clone();
+        swapped.buckets.swap(1, 5);
+        let rej = super::super::prove::verify(&keys, &proof, &swapped.to_halo2_instance()).is_err();
+        let threads = std::env::var("RAYON_NUM_THREADS").unwrap_or_else(|_| "default".into());
+        println!(
+            "ZKP3R-V2 threads={threads}: keygen {keygen_ms:.0} ms; proof {} B (cap 15360); prove median {:.1} ms (n={n}); verify median {:.2} ms; swapped-bucket rejected {rej}",
+            proof.len(), median(prove_ms), median(verify_ms)
+        );
+    }
+}
