+// ----------------------------------------------------------------
+// Nullifier behavior
+// ----------------------------------------------------------------
+
+#[test]
+fn zkp3r_nullifier_distinct_across_proposals_same_within_proposal() {
+    // Delegate 17 routed p=3 -> 1 (leaf 3), p=4 -> 0 (leaf 4), p=1 -> 2 (leaf 1).
+    let p3 = build::<ROUTE_TREE_DEPTH>(&Fx::default());
+    let p4 = build::<ROUTE_TREE_DEPTH>(&Fx { p: 4, o: 0, route_open: 4, ..Fx::default() });
+    let p1 = build::<ROUTE_TREE_DEPTH>(&Fx { p: 1, o: 2, route_open: 1, ..Fx::default() });
+    for b in [&p3, &p4, &p1] {
+        assert!(ok(b));
+    }
+    let nfs = [p3.instance.nullifier, p4.instance.nullifier, p1.instance.nullifier];
+    assert!(nfs[0] != nfs[1] && nfs[0] != nfs[2] && nfs[1] != nfs[2], "distinct per proposal");
+
+    // Same share, same proposal, fresh re-randomizer: identical nullifier,
+    // different (unlinkable) ciphertext. The chain's nullifier set rejects
+    // the second reveal.
+    let again = build::<ROUTE_TREE_DEPTH>(&Fx { r: pallas::Base::from(0xabcdef_u64), ..Fx::default() });
+    assert!(ok(&again));
+    assert_eq!(again.instance.nullifier, p3.instance.nullifier);
+    assert_ne!(again.instance.c1, p3.instance.c1);
+    assert_ne!(again.instance.c2, p3.instance.c2);
+
+    // Different share of the same DC, same proposal: distinct nullifier.
+    let other_share = build::<ROUTE_TREE_DEPTH>(&Fx { share_index: 6, ..Fx::default() });
+    assert!(ok(&other_share));
+    assert_ne!(other_share.instance.nullifier, p3.instance.nullifier);
+
+    // Native: nullifier ignores o and r'.
+    let dc = p3.dc;
+    let idx = pallas::Base::from(5u64);
+    let n = |p: u64| routed_share_nullifier_hash(dc, idx, p3.blinds[5], pallas::Base::from(p));
+    assert_eq!(n(3), p3.instance.nullifier);
+    assert_ne!(n(3), n(4));
+}
+
+#[test]
+fn zkp3r_rejects_reused_or_foreign_nullifier() {
+    let p3 = base();
+    let p4 = build::<ROUTE_TREE_DEPTH>(&Fx { p: 4, o: 0, route_open: 4, ..Fx::default() });
+    // p=4 reveal claiming p=3's nullifier.
+    let mut inst = p4.instance.clone();
+    inst.nullifier = p3.instance.nullifier;
+    assert!(!ok_raw(&p4, inst.to_halo2_instance()));
+    // ZKP3's share-spend nullifier formula is domain-separated from R7.
+    let mut inst = p3.instance.clone();
+    inst.nullifier = crate::share_reveal::share_nullifier_hash(p3.dc, pallas::Base::from(5u64), p3.blinds[5]);
+    assert!(!ok_raw(&p3, inst.to_halo2_instance()));
+}
