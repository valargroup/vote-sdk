+fn median(mut v: Vec<f64>) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+fn timing<const RD: usize>(n: usize) {
+    use std::time::Instant;
+    let t = Instant::now();
+    let keys = super::prove::keygen::<RD, 0>().unwrap();
+    let keygen_ms = t.elapsed().as_secs_f64() * 1e3;
+    let b = build::<RD>(&Fx::default());
+    let mut proof = Vec::new();
+    let mut prove_ms = Vec::new();
+    for _ in 0..n {
+        let t = Instant::now();
+        proof = super::prove::prove::<RD, 0>(&keys, b.circuit.clone(), &b.instance.to_halo2_instance()).unwrap();
+        prove_ms.push(t.elapsed().as_secs_f64() * 1e3);
+    }
+    let mut verify_ms = Vec::new();
+    for _ in 0..n {
+        let t = Instant::now();
+        super::prove::verify(&keys, &proof, &b.instance.to_halo2_instance()).unwrap();
+        verify_ms.push(t.elapsed().as_secs_f64() * 1e3);
+    }
+    // Real-verifier negatives.
+    let mut wrong_o = b.instance.clone();
+    wrong_o.vote_decision = pallas::Base::from(2u64);
+    let mut wrong_p = b.instance.clone();
+    wrong_p.proposal_id = pallas::Base::from(4u64);
+    let mut wrong_c = b.instance.clone();
+    wrong_c.c1 = (-wrong_c.c1).into();
+    let rej = [wrong_o, wrong_p, wrong_c].iter().filter(|i| super::prove::verify(&keys, &proof, &i.to_halo2_instance()).is_err()).count();
+    let threads = std::env::var("RAYON_NUM_THREADS").unwrap_or_else(|_| "default".into());
+    println!(
+        "ZKP3R RD={RD} threads={threads}: keygen {keygen_ms:.0} ms; proof {} B (cap 15360); prove median {:.1} ms (min {:.1}, max {:.1}, n={n}); verify median {:.2} ms; real-verifier rejections {rej}/3",
+        proof.len(), median(prove_ms.clone()), prove_ms.iter().cloned().fold(f64::MAX, f64::min), prove_ms.iter().cloned().fold(0.0, f64::max), median(verify_ms)
+    );
+}
