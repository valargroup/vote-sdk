FROM --platform=$BUILDPLATFORM golang:1.24.3-bookworm AS go
FROM --platform=$BUILDPLATFORM rust:1.91-bookworm AS rust
FROM --platform=$BUILDPLATFORM ubuntu:22.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates git pkg-config clang gcc-x86-64-linux-gnu gcc-aarch64-linux-gnu && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends libc6-dev-amd64-cross libc6-dev-arm64-cross && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/go/bin:/usr/local/cargo/bin:$PATH CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
WORKDIR /src
COPY . .
ARG TARGETARCH
ARG VERSION=v1.6.0-rc.6
ARG COMMIT
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,id=svote-upgrade-rust-${TARGETARCH},target=/src/circuits/target \
    case "$TARGETARCH" in amd64) target=x86_64-unknown-linux-gnu ;; arm64) target=aarch64-unknown-linux-gnu ;; *) exit 1 ;; esac && \
    rustup target add "$target" && cargo build --release --manifest-path circuits/Cargo.toml --no-default-features --features zakura --target "$target" && \
    mkdir -p /ffi && cp "circuits/target/$target/release/libshielded_vote_circuits.a" /ffi/
RUN mkdir -p circuits/target/release && cp /ffi/libshielded_vote_circuits.a circuits/target/release/
RUN --mount=type=cache,target=/root/go/pkg/mod --mount=type=cache,id=svote-upgrade-go-${TARGETARCH},target=/root/.cache/go-build \
    case "$TARGETARCH" in amd64) export CC=x86_64-linux-gnu-gcc ;; arm64) export CC=aarch64-linux-gnu-gcc ;; *) exit 1 ;; esac && \
    CGO_ENABLED=1 GOOS=linux GOARCH="$TARGETARCH" go build -tags halo2,redpallas -ldflags "-X github.com/cosmos/cosmos-sdk/version.Name=shielded-vote -X github.com/cosmos/cosmos-sdk/version.AppName=svoted -X github.com/cosmos/cosmos-sdk/version.Version=${VERSION} -X github.com/cosmos/cosmos-sdk/version.Commit=${COMMIT} -X 'github.com/cosmos/cosmos-sdk/version.BuildTags=halo2 redpallas'" -o /out/svoted ./cmd/svoted
RUN --mount=type=cache,target=/root/go/pkg/mod --mount=type=cache,id=svote-upgrade-go-${TARGETARCH},target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH="$TARGETARCH" go build -o /out/create-val-tx ./scripts/create-val-tx
FROM build AS e2e-build
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git --mount=type=cache,id=svote-upgrade-e2e,target=/src/e2e-tests/target \
    cargo test --release --manifest-path e2e-tests/Cargo.toml --test atomic_delegate_cast --no-run && \
    cp "$(find e2e-tests/target/release/deps -maxdepth 1 -name 'atomic_delegate_cast-*' -type f -executable | head -1)" /out/atomic-delegate-cast
FROM scratch AS e2e-export
COPY --from=e2e-build /out/ /
FROM scratch AS binary-export
COPY --from=build /out/ /
