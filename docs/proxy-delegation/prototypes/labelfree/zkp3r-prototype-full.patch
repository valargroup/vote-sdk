+/// Domain tag for DC slot nullifiers.
+pub(crate) fn proxy_delegation_slot_tag() -> pallas::Base {
+    use crate::ff::PrimeField;
+    let mut b = [0u8; 32];
+    b[..21].copy_from_slice(b"proxy delegation slot");
+    pallas::Base::from_repr(b).unwrap()
+}
