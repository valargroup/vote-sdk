+use super::*;
+use crate::ff::{Field, PrimeFieldBits};
+use crate::gadgets::elgamal::{base_to_scalar, elgamal_encrypt, spend_auth_g_affine};
+use crate::gadgets::van_integrity::van_integrity_hash;
