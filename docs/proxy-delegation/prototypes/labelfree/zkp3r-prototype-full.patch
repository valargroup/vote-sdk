+
+#[test]
+fn zkp3r_rejects_wrong_ciphertext() {
+    let fx = Fx::default();
+    let i = fx.share_index;
+    let (_, ea_pk) = ea_keypair();
+
+    // (a) Another share of the same DC (j != share_index) as witness and output.
+    let mut b = base();
+    let j = 9;
+    b.circuit.enc_c1 = Value::known(b.c1[j]);
+    b.circuit.enc_c2 = Value::known(b.c2[j]);
+    let (c1p, c2p) = rerandomize(b.c1[j], b.c2[j], fx.r, ea_pk);
+    b.instance.c1 = c1p;
+    b.instance.c2 = c2p;
+    assert!(!ok(&b), "share j substituted");
+
+    // (b) Forged plaintext (v + 1000) under the same randomness, as witness and output.
+    let mut b = base();
+    let (a, c, x, y) = elgamal_encrypt(pallas::Base::from(fx.shares[i] + 1000), b.randomness[i], ea_pk).unwrap();
+    let (f1, f2) = (affine(a, x), affine(c, y));
+    b.circuit.enc_c1 = Value::known(f1);
+    b.circuit.enc_c2 = Value::known(f2);
+    let (c1p, c2p) = rerandomize(f1, f2, fx.r, ea_pk);
+    b.instance.c1 = c1p;
+    b.instance.c2 = c2p;
+    assert!(!ok(&b), "forged witness ciphertext");
+
+    // (c) Honest witness, forged public output.
+    let mut b = base();
+    b.instance.c1 = c1p;
+    b.instance.c2 = c2p;
+    assert!(!ok(&b), "forged public output");
+
+    // (d) Homomorphic shift: C' = C + Enc(1; r').
+    let mut b = base();
+    let rs = base_to_scalar(fx.r).unwrap();
+    let g = spend_auth_g_affine();
+    b.instance.c2 = (b.c2[i] + ea_pk * rs + g).to_affine();
+    assert!(!ok(&b), "plaintext shifted by 1");
+
+    // (e) C2 re-randomized under a key other than the instance ea_pk.
+    let mut b = base();
+    let other = (g * pallas::Scalar::from(43u64)).to_affine();
+    b.instance.c2 = (b.c2[i] + other * rs).to_affine();
+    assert!(!ok(&b), "wrong key in C2'");
+
+    // (f) Inconsistent randomizers between C1' and C2'.
+    let mut b = base();
+    b.instance.c2 = (b.c2[i] + ea_pk * (rs + pallas::Scalar::one())).to_affine();
+    assert!(!ok(&b), "mixed r'");
+
+    // (g) Sign flip of C1'.
+    let mut b = base();
+    b.instance.c1 = (-b.instance.c1).into();
+    assert!(!ok(&b), "negated C1'");
+
+    // (h) r' = 0 would republish the original ciphertext.
+    let mut b = base();
+    b.circuit.rerandomizer = Value::known(pallas::Base::zero());
+    b.instance.c1 = b.c1[i];
+    b.instance.c2 = b.c2[i];
+    assert!(!ok(&b), "r' = 0");
+
+    // (i) Witness ea_pk differs from the instance ea_pk.
+    let mut b = base();
+    b.circuit.ea_pk = Value::known(other);
+    let (c1p, c2p) = rerandomize(b.c1[i], b.c2[i], fx.r, other);
+    b.instance.c1 = c1p;
+    b.instance.c2 = c2p;
+    assert!(!ok(&b), "witness ea_pk != instance ea_pk");
+}
+
