+fn cost_rows<const RD: usize, const M: usize>(k: u32, c: &Circuit<RD, M>) -> (usize, usize, usize, std::string::String) {
+    use voting_crypto_deps::halo2_proofs::dev::CircuitCost;
+    use voting_crypto_deps::pasta_curves::vesta;
+    let cost = CircuitCost::<vesta::Point, _>::measure(k, c);
+    let dbg = format!("{cost:?}");
+    let ex = |f: &str| -> usize {
+        dbg.split(&format!("{f}: ")).nth(1).and_then(|s| s.split([',', ' ', '}']).next()).and_then(|n| n.parse().ok()).unwrap_or(0)
+    };
+    (ex("max_rows"), ex("max_advice_rows"), ex("max_fixed_rows"), dbg)
+}
+
+fn report<const RD: usize>() {
+    let b = build::<RD>(&Fx::default());
+    let (rows, adv, fixed, dbg) = cost_rows(K, &b.circuit);
+    let (rows_default, _, _, _) = cost_rows(K, &Circuit::<RD>::default());
+    println!("=== ZKP3R route depth {RD} ===");
+    println!("  max_rows {rows}, max_advice_rows {adv}, max_fixed_rows {fixed}, 2^K = {}", 1usize << K);
+    println!("  witness independence: default max_rows {rows_default} ({})", if rows_default == rows { "PASS" } else { "FAIL" });
+    let mut cs = voting_crypto_deps::halo2_proofs::plonk::ConstraintSystem::<pallas::Base>::default();
+    <Circuit<RD> as voting_crypto_deps::halo2_proofs::plonk::Circuit<pallas::Base>>::configure(&mut cs);
+    let csd = format!("{cs:?}");
+    let ex = |f: &str| -> std::string::String {
+        csd.split(&format!("{f}: ")).nth(1).and_then(|s| s.split([',', ' ', '}']).next()).unwrap_or("?").into()
+    };
+    println!(
+        "  columns: advice {}, fixed {}, instance {}, blinding_factors {}, min_rows {}",
+        ex("num_advice_columns"), ex("num_fixed_columns"), ex("num_instance_columns"), cs.blinding_factors(), cs.minimum_rows()
+    );
+    println!("  debug: {dbg}");
+    for k in 9..=K {
+        let r = match MockProver::run(k, &b.circuit, vec![b.instance.to_halo2_instance()]) {
+            Err(e) => format!("synthesis rejected ({e:?})"),
+            Ok(p) => match p.verify() {
+                Ok(()) => "PASS".into(),
+                Err(e) => format!("{} failures", e.len()),
+            },
+        };
+        println!("  K={k}: {r}");
+    }
+}
