+//! PROTOTYPE: Routed share reveal (ZKP3R) for label-free proxy delegation.
+//!
+//! Reveals one share of a delegation commitment `DC = Poseidon(DOMAIN_VC,
+//! round, shares_hash, 0, d)` directly into the option bucket `(p, o)` that
+//! delegate `d` routed, as a re-randomized ciphertext. Nothing public names
+//! `d`; see `circuit.rs` for the conditions.
+
+mod circuit;
+pub mod prove;
+
+pub use circuit::{
+    domain_tag_routed_share_spend, rerandomize, route_leaf_hash, routed_share_nullifier_hash,
+    Circuit, Instance, InstanceV2, DOMAIN_ROUTE, K, ROUTE_TREE_DEPTH, V2_BUCKETS,
+};
+
+#[cfg(test)]
+pub(crate) mod tests;
diff -ruN -x target -x Cargo.lock pristine/voting-circuits/src/routed_share_reveal/prove.rs circuit/voting-circuits/src/routed_share_reveal/prove.rs
--- pristine/voting-circuits/src/routed_share_reveal/prove.rs	1969-12-31 17:00:00
+++ circuit/voting-circuits/src/routed_share_reveal/prove.rs	2026-10-05 18:57:42
@@ -0,0 +1,46 @@
+//! PROTOTYPE real Halo2 prove/verify for ZKP3R.
+
+use std::vec::Vec;
+
+use voting_crypto_deps::halo2_proofs::{
+    pasta::EqAffine,
+    plonk::{self, keygen_pk, keygen_vk},
+    poly::commitment::Params,
+};
+use voting_crypto_deps::pasta_curves::pallas;
+
+use super::circuit::{Circuit, K};
+use crate::{
+    prove_error::{create_proof_bytes, verify_proof_bytes},
+    ProveError,
+};
+
+/// IPA params, proving key and verifying key for one circuit shape.
+pub type Keys = (
+    Params<EqAffine>,
+    plonk::ProvingKey<EqAffine>,
+    plonk::VerifyingKey<EqAffine>,
+);
+
+/// Generates params and keys for route depth `RD` and bucket count `M`.
+pub fn keygen<const RD: usize, const M: usize>() -> Result<Keys, ProveError> {
+    let params = Params::new(K);
+    let empty = Circuit::<RD, M>::default();
+    let vk = keygen_vk(&params, &empty).map_err(ProveError::KeygenVk)?;
+    let pk = keygen_pk(&params, vk.clone(), &empty).map_err(ProveError::KeygenPk)?;
+    Ok((params, pk, vk))
+}
+
+/// Creates a serialized proof for the given public inputs.
+pub fn prove<const RD: usize, const M: usize>(
+    keys: &Keys,
+    circuit: Circuit<RD, M>,
+    public_inputs: &[pallas::Base],
+) -> Result<Vec<u8>, ProveError> {
+    create_proof_bytes(&keys.0, &keys.1, circuit, public_inputs)
+}
+
+/// Verifies a serialized proof against `public_inputs`.
+pub fn verify(keys: &Keys, proof: &[u8], public_inputs: &[pallas::Base]) -> Result<(), std::string::String> {
+    verify_proof_bytes("zkp3r", &keys.0, &keys.2, proof, public_inputs)
+}
