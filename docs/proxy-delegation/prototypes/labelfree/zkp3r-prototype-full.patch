+#[test]
+fn zkp3r_rejects_wrong_delegate() {
+    // (a) Prover opens delegate 9's route (9, 3, 1) and witnesses d = 9,
+    // but the DC commits to d = 17: R2 fails.
+    let fx = Fx { route_open: 2, ..Fx::default() };
